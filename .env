# SIGMA-HOSTING configuration
# Copy this file to .env and fill in your own values.

# Bot token from @BotFather (required)
BOT_TOKEN=8364530639:AAFI9qHUtgvi1ShlYfGMqAi20A_6Xh7_dzE

TOKEN=8364530639:AAFI9qHUtgvi1ShlYfGMqAi20A_6Xh7_dzE
# Comma separated Telegram user IDs that get the admin panels
ADMIN_IDS=8156053366

# Comma separated owner IDs: full access, including /setlogchannel and /shutdown
OWNER_IDS=8156053366

# Channel that receives every log event.
# 1. Create a private channel
# 2. Add this bot as an administrator with "post messages"
# 3. Forward any channel message to @userinfobot to read the -100... ID
# You can also set this at runtime with /setlogchannel -1001234567890
LOG_CHANNEL=-1003900351948

# Optional: a second bot token used when a suspicious script is run inside the
# sandbox. The real token is swapped for this one so a malicious upload can
# never reach your live bot.
CHECKER_BOT_TOKEN=8638572607:AAEAKVtzK6Vz3FNpDl7IpXVtxsnyzdLhw1Q

# Approve uploads automatically instead of holding them for review (0 or 1)
AUTO_APPROVE=0
